{
  "name": "ict-ai-knowledge-system",
  "version": "1.0.0",
  "description": "AI/LLM Knowledge System for ICT Trading Concepts",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "copy-assets": "cp -r public/* dist/ 2>/dev/null || true",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "generate-embeddings": "ts-node src/scripts/generate-embeddings.ts",
    "export-training-data": "ts-node src/scripts/export-training-data.ts",
    "validate-knowledge": "ts-node src/scripts/validate-knowledge.ts",
    "deploy": "./deploy.sh",
    "serve": "cd public && python3 -m http.server 8000 || python -m SimpleHTTPServer 8000"
  },
  "keywords": [
    "ICT",
    "trading",
    "AI",
    "knowledge-graph",
    "embeddings",
    "LLM"
  ],
  "author": "ICT Knowledge System",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/auth-js": "^2.55.0",
    "@supabase/supabase-js": "^2.38.4",
    "axios": "^1.12.2",
    "bcryptjs": "^2.4.3",
    "compromise": "^14.10.0",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "csv-writer": "^1.6.0",
    "d3": "^7.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "faiss-node": "^0.5.1",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonlines": "^0.1.1",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^0.0.208",
    "natural": "^6.12.0",
    "neo4j-driver": "^5.15.0",
    "openai": "^4.20.1",
    "pg": "^8.11.3",
    "rate-limiter-flexible": "^2.4.2",
    "socket.io": "^4.7.4",
    "sqlite3": "^5.1.6",
    "winston": "^3.11.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/natural": "^5.1.5",
    "@types/node": "^20.10.4",
    "@types/pg": "^8.10.9",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
